def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="P2P chat over Tor onion services.")
    sub = parser.add_subparsers(dest="command", required=True)

    p_host = sub.add_parser("host", help="wait for a peer to connect to you")
    p_host.add_argument("--control-port", type=int, default=DEFAULT_CONTROL_PORT)
    p_host.add_argument("--key", default=None)
    p_host.add_argument("--persist", metavar="FILE", default=None)
    p_host.add_argument("--plain", action="store_true")

    p_conn = sub.add_parser("connect", help="connect out to a peer's onion address")
    p_conn.add_argument("onion_address")
    p_conn.add_argument("--port", type=int, default=VIRTUAL_ONION_PORT)
    p_conn.add_argument("--socks-port", type=int, default=DEFAULT_SOCKS_PORT)
    p_conn.add_argument("--key", default=None)
    p_conn.add_argument("--plain", action="store_true")

    return parser


def main():
    args = build_parser().parse_args()
    use_plain = args.plain or not TEXTUAL_AVAILABLE

    if not TEXTUAL_AVAILABLE and not args.plain:
        print("[*] Textual isn't installed -- falling back to plain mode.")

    if use_plain:
        if args.command == "host":
            cmd_host_plain(args)
        else:
            cmd_connect_plain(args)
    else:
        app = ChatApp(args)
        app.run()


if __name__ == "__main__":
    main()
